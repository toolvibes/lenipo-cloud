{
  "name": "lenipo-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Lenipo Cloud: registration, provisioning and lifecycle of hosted Lenipo instances.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome ci .",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/formbody": "9.0.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "nodemailer": "10.1.7",
    "postgres": "3.4.9",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
